<odoo>

    <record id="hr_leave_view_kanban_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.kanban.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban"/>
        <field name="arch" type="xml">

            
            <xpath expr="//t[@t-name='card']//field[@name='duration_display']/ancestor::div[contains(@class,'col-2') and contains(@class,'o_hr_holidays_card')][1]" position="replace">
                <div class="col-2 o_hr_holidays_card">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="badge rounded-pill"><field name="number_of_days"/> days</span>
                        <span class="badge rounded-pill"><field name="number_of_hours"/> hours</span>
                    </div>
                    Amount
                </div>
            </xpath>

        </field>
    </record>

</odoo>
